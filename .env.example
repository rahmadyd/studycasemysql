# External AI Providers (One is required for AI generation; without any key, mock generator is used)
GEMINI_API_KEY=
EMERGENT_LLM_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# External MySQL Database Connection (Optional)
# If provided, the app creates an isolated throwaway database to test queries and capture actual outputs
# If not provided, execution test is skipped with "Belum diuji eksekusi"
MYSQL_URL=mysql://root:password@127.0.0.1:3306/mysql
